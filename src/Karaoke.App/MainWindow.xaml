<Window x:Class="Karaoke.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Karaoke Interactivo — Daniel León"
        Width="1280" Height="820" MinWidth="960" MinHeight="620"
        Background="#05030F" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <!-- Botón base: texto escalable (Viewbox), sin foco para que la barra espaciadora no dispare botones en vivo -->
        <Style x:Key="NeonBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Impact"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Viewbox Margin="6,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatBtn" TargetType="Button" BasedOn="{StaticResource NeonBtn}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#9A9A9A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Light" TargetType="Ellipse">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Stroke" Value="#FFB0B0"/>
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#FF9A9A" Offset="0"/>
                        <GradientStop Color="#E00000" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="230*"/>
            <RowDefinition Height="715*"/>
            <RowDefinition Height="295*"/>
            <RowDefinition Height="235*"/>
        </Grid.RowDefinitions>

        <!-- ============ FILA 0: equipos, asistente, tiempo ============ -->
        <Grid Grid.Row="0" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360*"/>
                <ColumnDefinition Width="1000*"/>
                <ColumnDefinition Width="600*"/>
                <ColumnDefinition Width="380*"/>
            </Grid.ColumnDefinitions>

            <!-- Equipo rojo -->
            <Border x:Name="RedPanel" Grid.Column="0" CornerRadius="16" BorderThickness="4"
                    BorderBrush="#FF6BA0" Background="#D81B5B" Margin="2">
                <Grid Margin="10,6">
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <Viewbox><TextBlock Text="EQUIPO ROJO" FontFamily="Impact" Foreground="White"/></Viewbox>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                        <Border Background="#FFB3D9" CornerRadius="8" Margin="2"><Viewbox Margin="6"><TextBlock Text="👤"/></Viewbox></Border>
                        <Border Grid.Column="1" Background="#4A0A22" CornerRadius="8" Margin="2">
                            <Viewbox Margin="4"><TextBlock x:Name="RedScore" Text="0" FontFamily="Impact" Foreground="White"/></Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Encabezado del asistente -->
            <Border Grid.Column="1" CornerRadius="26" BorderThickness="4" BorderBrush="#2DA8FF"
                    Background="#0A1A4A" Margin="6,2">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="3.6*"/><ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Margin="4">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#58C8FF" Offset="0.5"/>
                                <GradientStop Color="#0B4FB0" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border Grid.Column="1" Background="#1E50B4" Margin="8,6">
                        <Viewbox Margin="4"><TextBlock x:Name="RoundNumber" Text="1" FontFamily="Impact" Foreground="White"/></Viewbox>
                    </Border>
                    <Grid Grid.Column="2" Margin="6,0">
                        <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                        <Viewbox HorizontalAlignment="Left"><TextBlock x:Name="HeaderName" Text="Alexa..." FontFamily="Impact" Foreground="#3FD0FF"/></Viewbox>
                        <Viewbox Grid.Row="1" HorizontalAlignment="Left"><TextBlock x:Name="HeaderSub" Text="¡Primera canción!" FontFamily="Impact" Foreground="White"/></Viewbox>
                    </Grid>
                    <StackPanel x:Name="EqPanel" Grid.Column="3" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Tiempo -->
            <Grid Grid.Column="2" Margin="10,0">
                <Grid.RowDefinitions><RowDefinition Height="1*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource Light}"/><Ellipse Style="{StaticResource Light}"/><Ellipse Style="{StaticResource Light}"/>
                    <Border Background="#7A0000" BorderBrush="#FFD23C" BorderThickness="2" CornerRadius="6" Padding="14,0" Margin="6,0">
                        <TextBlock Text="TIEMPO" FontFamily="Impact" FontSize="26" Foreground="#FFD23C"/>
                    </Border>
                    <Ellipse Style="{StaticResource Light}"/><Ellipse Style="{StaticResource Light}"/><Ellipse Style="{StaticResource Light}"/>
                </StackPanel>
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ProgressBar x:Name="TimerBar" Grid.Column="1" Height="38" Minimum="0" Maximum="1" Value="0"
                                 Margin="-20,0,0,0" Foreground="#1E6BFF" Background="White" BorderBrush="#2DA8FF" BorderThickness="3"/>
                    <Border Width="92" Height="92" CornerRadius="46" Background="#0B2A7A" BorderBrush="#3FA0FF" BorderThickness="4">
                        <Viewbox Margin="10"><TextBlock x:Name="TimerText" Text="0:00" FontFamily="Impact" Foreground="White"/></Viewbox>
                    </Border>
                </Grid>
            </Grid>

            <!-- Equipo azul -->
            <Border x:Name="BluePanel" Grid.Column="3" CornerRadius="16" BorderThickness="4"
                    BorderBrush="#4DB8FF" Background="#0B3F9E" Margin="2">
                <Grid Margin="10,6">
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <Viewbox><TextBlock Text="EQUIPO AZUL" FontFamily="Impact" Foreground="White"/></Viewbox>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                        <Border Background="#A8D8FF" CornerRadius="8" Margin="2"><Viewbox Margin="6"><TextBlock Text="👤"/></Viewbox></Border>
                        <Border Grid.Column="1" Background="#041A45" CornerRadius="8" Margin="2">
                            <Viewbox Margin="4"><TextBlock x:Name="BlueScore" Text="0" FontFamily="Impact" Foreground="White"/></Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ FILA 1: panel central + medidores L/R ============ -->
        <Grid Grid.Row="1" Margin="10,2,10,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>

            <Border CornerRadius="60" BorderThickness="8" BorderBrush="#FFB800" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1A0B3F" Offset="0"/>
                        <GradientStop Color="#3A1585" Offset="0.6"/>
                        <GradientStop Color="#0A2A66" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="1*"/><RowDefinition Height="7*"/></Grid.RowDefinitions>

                    <!-- Frase / pregunta actual -->
                    <Border Margin="170,14,170,0" Background="#EEF0F4" CornerRadius="4">
                        <Viewbox Margin="6,2"><TextBlock x:Name="PanelTitle" Text="ADIVINA LA CANCION....." FontFamily="Impact" Foreground="#E01010"/></Viewbox>
                    </Border>

                    <!-- Texto largo (instrucciones, avisos) -->
                    <Border x:Name="PanelBodyBorder" Grid.Row="1" Margin="140,20,140,40" Background="#C0000000"
                            CornerRadius="22" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="PanelBody" TextWrapping="Wrap" TextAlignment="Center" Foreground="White"
                                   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="34" Padding="28"/>
                    </Border>

                    <!-- Logotipos reemplazables (Configuración > Logotipos, etapa 3) -->
                    <Grid Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,16,0,0" Width="170" Height="170">
                        <TextBlock x:Name="LogoLeftText" Text="LOGO&#10;IZQUIERDO" TextAlignment="Center" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Impact" FontSize="22"/>
                        <Image x:Name="LogoLeftImg" Stretch="Uniform"/>
                    </Grid>
                    <Grid Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,26,0" Width="170" Height="170">
                        <TextBlock x:Name="LogoRightText" Text="LOGO&#10;DERECHO" TextAlignment="Center" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Impact" FontSize="22"/>
                        <Image x:Name="LogoRightImg" Stretch="Uniform"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Medidores estéreo L / R (se alimentan con el nivel real en la etapa 6) -->
            <Border Grid.Column="1" Background="#101010" Margin="4,0,0,0" BorderBrush="#555" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border x:Name="MeterHostL" Background="#262626" Margin="1"><Rectangle x:Name="MeterL" VerticalAlignment="Bottom" Height="0" Fill="LimeGreen"/></Border>
                        <Border x:Name="MeterHostR" Grid.Column="1" Background="#262626" Margin="1"><Rectangle x:Name="MeterR" VerticalAlignment="Bottom" Height="0" Fill="LimeGreen"/></Border>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="L" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="R" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ FILA 2: botonera 9 x 4 (se genera en código) ============ -->
        <UniformGrid x:Name="ButtonGrid" Grid.Row="2" Rows="4" Columns="9" Margin="10,0"/>

        <!-- ============ FILA 3: controles inferiores ============ -->
        <Grid Grid.Row="3" Margin="10,4,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1130*"/>
                <ColumnDefinition Width="570*"/>
                <ColumnDefinition Width="680*"/>
            </Grid.ColumnDefinitions>

            <!-- Paletas -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                    <UniformGrid Columns="1">
                        <Button x:Name="BtnAssign" Style="{StaticResource FlatBtn}" Content="Asignar Jingle al Botón" Click="Config_Click" Tag="1"/>
                        <Button x:Name="BtnSavePalette" Style="{StaticResource FlatBtn}" Content="Guardar Paleta Actual" Click="SavePalette_Click"/>
                        <Button x:Name="BtnClearPalette" Style="{StaticResource FlatBtn}" Content="Detener y Vaciar Paleta" Click="ClearPalette_Click"/>
                    </UniformGrid>
                    <ListBox x:Name="PaletteList" Grid.Column="1" Margin="3" FontSize="16" SelectionChanged="PaletteList_SelectionChanged"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatBtn}" Width="150" Content="Configuración" Click="Config_Click" Tag="0"/>
                    <Button Style="{StaticResource FlatBtn}" Width="150" Content="Paleta Anterior" Click="PrevPalette_Click"/>
                    <Button Style="{StaticResource FlatBtn}" Width="150" Content="Paleta Siguiente" Click="NextPalette_Click"/>
                    <Button x:Name="BtnFullscreen" Style="{StaticResource NeonBtn}" Width="60" Background="#32E632" Foreground="#6A00B0" Content="⛶" FontFamily="Segoe UI Symbol" Click="Fullscreen_Click"/>
                </StackPanel>
            </Grid>

            <!-- Pantalla negra + instrucciones + celebraciones 1 y 2 -->
            <Grid Grid.Column="1" Margin="0,0,6,0">
                <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                <Border Background="Black" BorderBrush="#444" BorderThickness="1" Margin="3">
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DisplayElapsed" Text="00:00" Foreground="#3CD86A" FontFamily="Consolas" FontSize="30"/>
                            <TextBlock x:Name="DisplayNow" Text="(Ninguno)" Foreground="#C8C8C8" FontSize="13"/>
                            <TextBlock x:Name="DisplayPalette" Text="" Foreground="#C8C8C8" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="DisplayClock" Text="00:00:00" Foreground="#3CD86A" FontFamily="Consolas" FontSize="24" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="DisplayDate" Text="" Foreground="#C8C8C8" FontSize="13" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <UniformGrid Grid.Row="1" Columns="3">
                    <Button x:Name="BtnInstr" Style="{StaticResource NeonBtn}" Content="INSTRUCCIONES&#10;DEL JUEGO" Foreground="#FFE600" Click="Instructions_Click">
                        <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C050F0" Offset="0"/><GradientStop Color="#7A10B8" Offset="1"/></LinearGradientBrush></Button.Background>
                    </Button>
                    <Button x:Name="BtnCel1" Style="{StaticResource NeonBtn}" Content="CELEBRACION" Tag="1" Foreground="#143A00" Click="Celebration_Click"/>
                    <Button x:Name="BtnCel2" Style="{StaticResource NeonBtn}" Content="CELEBRACION" Tag="2" Foreground="#143A00" Click="Celebration_Click"/>
                </UniformGrid>
            </Grid>

            <!-- Celebraciones 3 y 4, PUNTO, CALIFICAR, pausa, salir, detener todo -->
            <UniformGrid Grid.Column="2" Rows="2" Columns="4">
                <Button x:Name="BtnCel3" Style="{StaticResource NeonBtn}" Content="CELEBRACION" Tag="3" Foreground="#143A00" Click="Celebration_Click"/>
                <Button x:Name="BtnPointRed" Style="{StaticResource NeonBtn}" Content="PUNTO" Background="#E81818" Foreground="#FFE600" Click="PointRed_Click"/>
                <Button x:Name="BtnRate" Style="{StaticResource NeonBtn}" Content="CALIFICAR" Background="#F020C8" Click="Rate_Click"/>
                <Button x:Name="BtnExit" Style="{StaticResource FlatBtn}" Content="Salir" Click="Exit_Click"/>
                <Button x:Name="BtnCel4" Style="{StaticResource NeonBtn}" Content="CELEBRACION" Tag="4" Foreground="#143A00" Click="Celebration_Click"/>
                <Button x:Name="BtnPointBlue" Style="{StaticResource NeonBtn}" Content="PUNTO" Background="#1850E8" Foreground="#FFE600" Click="PointBlue_Click"/>
                <Button x:Name="BtnPause" Style="{StaticResource FlatBtn}" Content="⏸" FontFamily="Segoe UI Symbol" Click="Pause_Click"/>
                <Button x:Name="BtnStopAll" Style="{StaticResource FlatBtn}" Content="DETENER TODO" FontFamily="Impact" FontWeight="Normal" Click="StopAll_Click"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
